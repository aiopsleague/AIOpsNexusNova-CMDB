NODE_ENV=production
VUE_APP_PREVIEW=false
VUE_APP_API_BASE_URL=http://127.0.0.1:5000/api
VUE_APP_BUILD_PACKAGES="ticket,calendar,acl"
VUE_APP_IS_OUTER=true
VUE_APP_IS_OPEN_SOURCE=true
VUE_APP_KKFILEVIEW_SERVER=http://127.0.0.1:8012/onlinePreview
# 强制更新缓存的文件类型（kkFileView 转换时绕过缓存，始终重新转换，保证预览最新内容）
# 逗号分隔的文件后缀列表，默认同 kkFileView 的 simText 配置；代码内亦有相同默认值兜底
VUE_APP_KKFILEVIEW_FORCE_UPDATED_CACHE_TYPES=txt,html,htm,asp,jsp,xml,json,properties,md,gitignore,log,java,py,c,cpp,sql,sh,bat,m,bas,prg,cmd
# kkFileView 访问文件 API 时使用的外部地址（Docker 容器内 localhost 指向容器自身）
# Linux: 使用宿主机 IP 或配置 --add-host=host.docker.internal:host-gateway
# 默认使用浏览器当前地址（window.location.origin）
# VUE_APP_FILE_API_BASE_URL=http://host.docker.internal:8000
