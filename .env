# =============================================================================
# CMDB Production Environment Variables
# =============================================================================
# 复制此文件为 .env 并修改以下配置：
#   cp .env.example .env
#
# 生成安全密钥:
#   openssl rand -hex 32    → 用作 SECRET_KEY
#   openssl rand -base64 16 → 用作各类密码
# =============================================================================

# ---- 数据库 ------------------------------------------------------------------
 MYSQL_ROOT_PASSWORD='123456'
 MYSQL_HOST='mysql'
 MYSQL_PORT=3306
 MYSQL_USER='cmdb'
 MYSQL_DATABASE='cmdb'
 MYSQL_PASSWORD='123456'

# ---- 应用密钥 ----------------------------------------------------------------
# Flask/FastAPI session 签名密钥，务必修改为随机值
SECRET_KEY=change-me-to-a-random-secret-key

# ---- Nginx ------------------------------------------------------------------
# 宿主机暴露端口，默认 80
NGINX_PORT=80

# ---- 文件存储 (S3/MinIO) ----------------------------------------------------
FILE_STORAGE_BACKEND=s3
# MinIO 端点地址 (必须包含 http:// 或 https://)
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=KNmheadmu0s3xPOpjQ19
S3_SECRET_KEY=6Bj2WQyy1uzcqd0aXvT2SkwKBn56hX8ZsqNjV8m0
S3_BUCKET_NAME=cmdb-files
S3_REGION=us-east-1
S3_USE_SSL=false

# ---- Docker 镜像 ------------------------------------------------------------
# 生产环境使用预构建镜像，默认使用本地构建的 latest 标签。
# 如果使用远程仓库镜像，取消注释并修改：
REGISTRY=harbor.it.cgzair.com/aiopsnexusnova
CMDB_API_IMAGE=${REGISTRY}/cmdb-api:latest
CMDB_UI_IMAGE=${REGISTRY}/cmdb-ui:latest
