# =============================================================================
# CMDB Production Environment Variables
# =============================================================================
# 复制此文件为 .env 并修改以下配置：
#   cp .env.example .env
#
# 生成安全密钥:
#   openssl rand -hex 32    → 用作 SECRET_KEY
#   openssl rand -base64 16 → 用作各类密码
# =============================================================================

# ---- 数据库 ------------------------------------------------------------------
 MYSQL_ROOT_PASSWORD='123456'
 MYSQL_HOST='mysql'
 MYSQL_PORT=3306
 MYSQL_USER='cmdb'
 MYSQL_DATABASE='cmdb'
 MYSQL_PASSWORD='123456'

# ---- 应用密钥 ----------------------------------------------------------------
# Flask/FastAPI session 签名密钥，务必修改为随机值
SECRET_KEY=change-me-to-a-random-secret-key

# ---- Nginx ------------------------------------------------------------------
# 宿主机暴露端口，默认 80
NGINX_PORT=80

# ---- MinIO 对象存储 -----------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-to-a-secure-password

# ---- Docker 镜像 ------------------------------------------------------------
# 生产环境使用预构建镜像，默认使用本地构建的 latest 标签。
# 如果使用远程仓库镜像，取消注释并修改：
REGISTRY=harbor.it.cgzair.com/aiopsnexusnova
CMDB_API_IMAGE=${REGISTRY}/cmdb-api:latest
CMDB_UI_IMAGE=${REGISTRY}/cmdb-ui:latest
